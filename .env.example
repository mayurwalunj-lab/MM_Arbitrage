# Copy this file to .env and fill secrets on the machine running the services.

# MM bot dry-run master switch. Dry-run (simulate) unless set to exactly
# 'false'. Production MUST set BOT_DRY_RUN=false or the bots won't trade.
BOT_DRY_RUN=false

# Dynamic price band (shared/price_band.js) — makes the CEX bots + grids follow
# the DEX price instead of a fixed box. OFF by default; on = DYNAMIC_BAND=true.
# See docs/price-maintenance-plan.md.
DYNAMIC_BAND=false
BAND_REFRESH_MS=600000       # refetch DEX + move band every 10 min
BAND_SMOOTHING_ALPHA=0.2     # 9 EMA (~90 min) on the DEX price
BAND_MAX_MOVE_PCT=1.0        # max center move per refresh
BAND_FOLLOW_MAX_PCT=5        # freeze if DEX is this far from CEX (treasury handles it)
BAND_FREEZE_UPSIDE_ONLY=true # treasury only SELLS: freeze on upside spikes only; on a
                             # downside drop, ease down to BAND_ABS_MIN and hold (don't freeze)
BAND_INNER_SPREAD_PCT=0.7    # grid buy<->sell gap (HARD-capped at 1.0)
BAND_ABS_MIN=5               # absolute price floor the band can never cross
BAND_ABS_MAX=20              # absolute price ceiling the band can never cross
BAND_STALE_MS=300000         # freeze band if the DEX price is older than this
BAND_FALLBACK_CENTER=8.5     # center used only if the FIRST DEX read fails at startup

# SINGLE database config — used by bots, dashboard, arb module, migrations.
# (Legacy BITMART_DB_* / LBANK_DB_* keys still work as fallback if DB_* unset.)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=mm_production

# Uniswap L1X/WETH trading
ETH_RPC_URL=
# ETH/USD resolution order: live CEX (Bitmart/LBank) -> Chainlink on-chain feed
# -> this static value (last resort). Set ETH_USD_PRICE only as a final safety net.
ETH_USD_PRICE=
# Chainlink ETH/USD feed — on-chain fallback when the live CEX fetch fails (uses
# ETH_RPC_URL, no API key). Defaults to the mainnet feed. Reject answers older
# than CHAINLINK_MAX_STALE_SECONDS (0 disables the staleness check).
CHAINLINK_ETH_USD_FEED=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419
CHAINLINK_MAX_STALE_SECONDS=3600
UNISWAP_WALLET_PRIVATE_KEY=
UNISWAP_WALLET_ADDRESS=
UNISWAP_CHAIN_ID=1
L1X_TOKEN_ADDRESS=0x399Ef659FDeAD53B3E7f97E9491E727925667945
L1X_WETH_POOL_ADDRESS=0x9Fb1a1a98F995b2B3362a1238De1366BFa790006
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
UNISWAP_QUOTER_V2_ADDRESS=0x61fFE014bA17989E743c5F6cB21bF9697530B21e
UNISWAP_SWAP_ROUTER_02_ADDRESS=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
UNISWAP_DEFAULT_SLIPPAGE_BPS=100
UNISWAP_DEADLINE_SECONDS=600

# CEX->DEX arbitrage monitor (arb/monitor.js). Detection is dry-run only.
# Order placement stays blocked unless ARB_DRY_RUN=false is set explicitly.
ARB_DRY_RUN=true
ARB_PAIR=L1X/USDT
ARB_POLL_MS=5000
ARB_MIN_EDGE_USD=20
ARB_MIN_TRADE_L1X=10
ARB_MAX_TRADE_L1X=1000
ARB_CEX_TAKER_FEE_BPS=25
ARB_GAS_LIMIT_SWAP=200000
ARB_MAX_SPREAD_PCT=2
ARB_MIN_DEPTH_L1X=50
ARB_DEPTH_RANGE_PCT=2
ARB_PERSIST_TICKS=3
ARB_STALE_MS=3000
ARB_OWN_ORDERS_TTL_MS=10000
# false = evaluate the raw book INCLUDING our own grid/MM orders. Detection
# data only — never execute on it (buying your own orders is wash trading).
ARB_SELF_TRADE_FILTER=true
# Execution (Phase 2). ARB_DRY_RUN=false is the master lock for live orders.
# Stage A: npm run arb:execute (one command-triggered round).
# Stage B/C: ARB_AUTO_EXECUTE=true lets the monitor fire rounds itself, only
# above ARB_AUTO_MIN_EDGE_USD and within every cap below.
ARB_AUTO_EXECUTE=false
ARB_AUTO_MIN_EDGE_USD=40
# Hedge mode (leg 3): cex = sell ETH on exchange (USDT on exchange, needs
# exchange ETH); dex = swap WETH->USDT on Uniswap each trade (USDT in wallet,
# extra gas, no exchange ETH); skip = keep WETH, convert later via arb:convert
# (lowest gas, ETH-exposed until converted).
ARB_HEDGE_MODE=cex
# WETH->USDT conversion (for `arb:convert`). USDT_ADDRESS + the pool fee tier
# of the WETH/USDT Uniswap pool (500 = 0.05%, the deep ETH/USDT tier).
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
UNISWAP_USDT_POOL_FEE=500

# Treasury sell (arb/treasury_sell.js): sell treasury L1X on the DEX when it
# trades above the CEX price (down to the CEX price), convert to USDT.
# Directional (treasury L1X decreases) — not arbitrage. CEX price is the floor.
# TREASURY_MODE gates allowed directions: sell (only sell L1X when DEX above
# CEX) | buy (only buy back when DEX below CEX) | both. A blocked direction
# refuses to run.
# Live trading master switch for the treasury monitor (treasury_monitor under
# PM2). true = real sells/buys; anything else (or unset) = dry-run/simulate.
# Fail-safe: defaults to dry-run. The --execute CLI flag also forces live.
TREASURY_EXECUTE=false
TREASURY_MODE=both
TREASURY_MIN_PREMIUM_PCT=0.5
TREASURY_MAX_SELL_L1X=50
TREASURY_MAX_BUY_L1X=50
# Hard daily L1X volume cap (LIVE trades only), enforced per direction: at most
# this many L1X sold AND this many L1X bought per calendar day. Once reached,
# that direction skips for the rest of the day. dry-run is uncapped.
TREASURY_MAX_L1X_PER_DAY=50
TREASURY_SLIPPAGE_BPS=100
TREASURY_CONVERT_USDT=true
# Treasury monitor loop (treasury:monitor): poll interval, cooldown after an
# action, and a daily cap on LIVE trades (dry-run is uncapped).
TREASURY_POLL_MS=30000
TREASURY_COOLDOWN_MS=60000
TREASURY_MAX_TRADES_PER_DAY=20

# QDex (QuantumDex) market maker — hold the WL1X/XUSD pool price at a fixed
# target on the L1X chain (Uniswap-V3-style AMM). Dry-run unless QDEX_EXECUTE=true
# (or --execute). ALL config is read from here (no hardcoded defaults in code);
# the addresses below are the real mainnet values — the MM errors if any required
# one is missing.
# Comma-separate multiple endpoints for automatic failover (first healthy wins),
# e.g. QDEX_RPC_URL=https://rpc-a,https://rpc-b. Transient 502s are retried with
# backoff and never crash the MM.
QDEX_RPC_URL=https://v2-mainnet-rpc.l1x.foundation
QDEX_CHAIN_ID=1066
QDEX_POOL_ADDRESS=0x35a4Ef191750f6f70a29e58AcC2886de33a16DbD
QDEX_ROUTER_ADDRESS=0xA3A2dfF9f43Edc2825AC4C2Ff1A2945e103a37eB
QDEX_BASE_TOKEN=0x743B3A9094B2226AEfd5EbEE22071FCDb64c707f
QDEX_QUOTE_TOKEN=0xcCD313e2c962BCea8501A6691598EF9A98975ba7
QDEX_WALLET_ADDRESS=
QDEX_WALLET_PRIVATE_KEY=
# L1X price oracle (authoritative WL1X USD price) — used by peg mode + slippage floor.
QDEX_ORACLE_ADDRESS=0xbF730f5a23a63653457829ee88d3Aaf54453a809
# Optional QuoterV2 — if set, swap quotes use it (canonical). If empty, quotes are
# computed from the pool's own liquidity/sqrtPrice (impact-aware, no funds needed).
QDEX_QUOTER_ADDRESS=
# PEG MODE: hold XUSD at this USD value (e.g. 1.0). Target pool ratio =
# oracleWL1X / peg. Overrides QDEX_TARGET_PRICE. Empty/0 = use fixed target below.
QDEX_XUSD_PEG=
# FIXED-TARGET MODE: hold WL1X at this XUSD price (only if QDEX_XUSD_PEG unset).
QDEX_TARGET_PRICE=
QDEX_BAND_PCT=0.5           # +/- % deadband before it acts (keep > the 0.3% pool
                           # fee so it doesn't churn on noise; 0.5 recommended)
QDEX_CORRECT_TO=center     # center = correct fully back to peg | edge = only to
                           # the band edge | random = pick center/edge each tick
                           # (less mechanical / harder to read)
QDEX_MAX_DEVIATION_PCT=5    # breaker threshold: XUSD this far off peg = "danger"
QDEX_BREAKER_CONFIRM_TICKS=3 # a >max-deviation reading must persist this many
                           # consecutive ticks before acting (filters a transient
                           # oracle glitch); if it persists, correct it back to the band
QDEX_MAX_TRADE_BASE=0       # per-run cap in WL1X (0 = uncapped)
QDEX_SLIPPAGE_BPS=100       # slippage floor on live swaps (amountOutMinimum)
QDEX_POLL_MS=30000
QDEX_EXECUTE=false          # true = real swaps; else dry-run/simulate
ARB_EXEC_MAX_TRADE_USD=200
ARB_EXEC_MAX_TRADES_PER_HOUR=6
ARB_EXEC_DAILY_LOSS_LIMIT_USD=20
ARB_EXEC_LEG_TIMEOUT_MS=10000
ARB_EXEC_PRICE_BUFFER_BPS=10
ARB_EXEC_COOLDOWN_MS=60000
ARB_EXEC_SLIPPAGE_BPS=100
# Dedicated arb trading keys (NOT the MM/grid bot keys). Optional for the
# monitor: without them orderbooks still work, balances/orders do not.
ARB_BITMART_API_KEY=
ARB_BITMART_SECRET=
ARB_BITMART_UID=
ARB_LBANK_API_KEY=
ARB_LBANK_SECRET=
# Accounting DB for arb_* tables. Optional: falls back to BITMART_DB_* when
# unset (same MySQL server the MM bots use).
#ARB_DB_HOST=
#ARB_DB_PORT=
#ARB_DB_USER=
#ARB_DB_PASSWORD=
#ARB_DB_NAME=

# =============================================================================
# QDEX VOLUME TEST HARNESS (QVT_*)  —  qdex/volume/
# =============================================================================
# Generates randomised TEST trades across WL1X-paired QDex pools from a rotating
# roster of sub-wallets. This is test activity and is recorded as such: every
# database row carries is_test_activity=1, the roster is documented in
# qdex/VOLUME_TESTING.md, and the parent wallet never rotates so all of it traces
# to one address. It is NOT built to imitate organic user trading.
#
# SAFETY: dry-run is the default. To send real transactions you must set ALL of
# QVT_EXECUTE=true, QVT_ALLOWED_CHAIN_IDS, QVT_ALLOWED_POOLS, QVT_PARENT_PK and
# QVT_KEY_ENCRYPTION_KEY. Leaving the two allow-lists empty makes execution
# impossible by construction — that is the intended default.

# ---- network (falls back to the QDEX_* values above if unset) ----
QVT_RPC_URL=
QVT_CHAIN_ID=
QVT_WL1X=

# ---- EXECUTION GATE — all three required for live trading ----
QVT_EXECUTE=false
QVT_ALLOWED_CHAIN_IDS=          # e.g. 1066 — empty means nothing can execute
QVT_ALLOWED_POOLS=              # comma-separated pool addresses that may be traded

# ---- wallets ----
QVT_PARENT_PK=                  # parent/treasury key — funds and receives sweeps
QVT_WALLET_COUNT=10
QVT_DERIVATION_PATH=m/44'/60'/0'/0
QVT_KEYFILE=                    # default qdex/volume/.wallets.json (gitignored, 0600)
QVT_KEY_ENCRYPTION_KEY=         # 64 hex chars: npm run qdex:vol:secret
# Store private keys UNENCRYPTED in MySQL. Anyone with database access then holds
# spendable keys, and dashboard/Server.js serves that database over HTTP with open
# CORS — so never add a route selecting privkey_enc or mnemonic_enc. Off by default.
QVT_STORE_PLAINTEXT_KEYS=false

# ---- epoch rotation ----
QVT_EPOCH_DAYS=7                # roster lifetime; sweep in kind, then 10 fresh wallets

# ---- funding (WL1X is the cash leg — every QDex pool is WL1X-paired) ----
QVT_FUND_WL1X=3                 # WL1X per sub-wallet
QVT_FUND_GAS_NATIVE=0.5         # native L1X per sub-wallet (swaps are paid in native)
QVT_MIN_GAS_NATIVE=0.05         # below this a wallet is skipped
QVT_WALLET_FLOOR_WL1X=0.3       # below this a wallet gets a peer transfer
QVT_MIN_TRANSFER_WL1X=0.25      # no dust transfers
QVT_MAX_TRANSFERS_PER_HOUR=20
QVT_PARENT_RESERVE_PCT=10       # parent keeps this % back when funding/distributing

# ---- sizing: the IMPACT CAP is the real control ----
# QDex pool depth spans many orders of magnitude and liquidity() does not predict
# tradeable size, so size is derived per pool at quote time. The WL1X values below
# are only outer clamps.
QVT_MAX_IMPACT_BPS=25           # per-trade PRICE IMPACT ceiling (how far the pool moves)
# Ceiling on the REALISED cost of a swap, measured by simulating it against the
# real router: fee + slippage + anything else deducted. Different from the impact
# cap above. Measured on WL1X/L1USD: ~78bps at 2 WL1X, ~424bps at 0.05, ~978bps
# at 0.02 — small trades are very expensive here. 0 disables the check.
QVT_MAX_COST_BPS=150
QVT_MIN_TRADE_WL1X=0.05
QVT_MAX_TRADE_WL1X=1.0
QVT_MAX_POOL_FRACTION_BPS=50    # second ceiling relative to pool depth
QVT_SLIPPAGE_BPS=100
QVT_DEADLINE_SECONDS=600
# Hard bound on every broadcast and every wait. ethers polls forever by default,
# so a transaction the node silently drops hangs the bot with nothing in flight.
QVT_TX_TIMEOUT_MS=120000
# After a timeout, work out from the nonce whether anything was actually accepted
# and carry on, instead of halting the session. Only a genuinely undecidable
# outcome stops the bot — retrying blind would double-spend a transaction that
# was merely slow rather than dropped.
QVT_TIMEOUT_RECOVERY=true
QVT_TIMEOUT_RECHECK_ATTEMPTS=5
QVT_TIMEOUT_RECHECK_MS=6000

# ---- price guard ----
QVT_ANCHOR_MODE=session-start   # session-start | oracle | fixed
QVT_MAX_DEVIATION_PCT=0.75      # outside this band the side is forced corrective
QVT_INVENTORY_TARGET_PCT=50     # target WL1X share of each wallet's value
QVT_BIAS_STRENGTH=0.7           # 0 = coin flip, 1 = strongly inventory-driven

# ---- rate limiting and pacing ----
QVT_MAX_TX_PER_HOUR=100         # hard-capped at 100 in code
QVT_MIN_DELAY_MS=20000
QVT_MAX_DELAY_MS=60000
QVT_WALLET_COOLDOWN_MS=120000
QVT_POOL_WEIGHTING=sqrt         # sqrt | tvl | uniform — see VOLUME_TESTING.md

# ---- narrowing: run against a subset without changing anything else ----
# Labels or addresses. Empty = every configured pool. If nothing matches (a typo,
# or a pool that failed to load) the bot falls back to ALL pools and says so —
# it will not silently sit idle.
QVT_FOCUS_POOLS=                # e.g. L1USD   or   L1USD,M1X
QVT_ACTIVE_WALLETS=             # e.g. 2 — use only the first N of the roster (empty/0 = all)
# Both can be overridden per run:  npm run qdex:vol -- --pool L1USD --wallets 2

# ---- session budgets + emergency stop (0 = unlimited) ----
QVT_MAX_SESSION_TX=0
QVT_MAX_SESSION_NOTIONAL_WL1X=0
QVT_MAX_RUNTIME_MIN=0
QVT_MAX_CONSECUTIVE_FAILURES=5
QVT_MAX_CONSECUTIVE_RPC_ERRORS=25  # a dead RPC trips the stop instead of spinning
# A skip consumes no rate budget, so a fleet that cannot trade spins as fast as
# the RPC allows. Measured in production: 5.2 skips/second, ~450k rows a day.
# Backs off while skipping and stops after this many in a row. 0 disables.
QVT_MAX_CONSECUTIVE_SKIPS=200
# CONSOLIDATION. When a wallet has no tradeable WL1X and every token bag is below
# minTrade, it is fragmented rather than empty. Rather than sit stuck, sell the
# largest bag to recover WL1X and resume the normal cycle. Small trades are
# expensive (~424bps at 0.05 WL1X), so this has its own higher ceiling — paying
# 4% to free a stranded holding beats leaving it permanently unusable.
QVT_CONSOLIDATE_MIN_WL1X=0.03
QVT_CONSOLIDATE_MAX_COST_BPS=800
QVT_LOCK_FILE=                  # default qdex/volume/.LOCK — blocks a second instance
QVT_STOP_FILE=                  # default qdex/volume/.STOP — `touch` it to halt
QVT_TEST_TAG=QDEX-VOLUME-TEST

# ---- pools ----
# QDex runs TWO factory deployments, each with its own router, and a router can
# only reach its own factory's pools — so the router is PER POOL:
#   F1 factory 0xE22074DE1060298e3B45D46313ca32bC3fE2B86A
#      router  0xA3A2dfF9f43Edc2825AC4C2Ff1A2945e103a37eB
#   F2 factory 0xD565a80EAf4CCCf520F523052e30c0d9a12ccea4
#      router  0xfd6fce2C473CDa77D794a2B03A72c8F30F47F60d
# The XUSD/WL1X pool is deliberately absent: qdex_mm.js holds it at a peg and the
# two would fight. STACK is absent too — the QDex UI does not list it.
QVT_POOL_COUNT=10

# L1USD  TVL ~$1.33M  (50% WL1X)  F1
QVT_POOL_1_ADDRESS=0x3FE7dADF59686160b87aAb83D97d8e30C592A7F6
QVT_POOL_1_TOKEN=0x4884eaD91e743AE07436074bEB9C3AED3B6aefCd
QVT_POOL_1_ROUTER=0xA3A2dfF9f43Edc2825AC4C2Ff1A2945e103a37eB
QVT_POOL_1_LABEL=L1USD

# M1X  TVL ~$527K  (50% WL1X)  F2
QVT_POOL_2_ADDRESS=0x7B0B01297D18333aD13Bbd9DEAf8796D94298d26
QVT_POOL_2_TOKEN=0xD096f8807D70040Ba66241A5041d5D97B0538C49
QVT_POOL_2_ROUTER=0xfd6fce2C473CDa77D794a2B03A72c8F30F47F60d
QVT_POOL_2_LABEL=M1X

